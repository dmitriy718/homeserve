# Primary LAN address of this host. Every web UI and API port in
# compose/ai-node.yml binds to this address (and to TAILSCALE_IP below).
# Detect it with: ip -4 route get 1.1.1.1
LAN_IP=192.168.1.68

# Tailscale address of this host. The stack binds ports here as well, and
# ai-node-stack.service waits for both addresses before starting Compose.
# If Tailscale is not used, set this to 127.0.0.1 (install.sh --skip-tailscale).
TAILSCALE_IP=100.65.105.46

# Timezone used by Speedtest Tracker for its schedule and result display.
TZ=America/New_York

# Base domain for the Caddy edge proxy. Services are served with internal TLS
# at <name>.BASE_DOMAIN (webui., grafana., kuma., ...); the landing dashboard
# is at the bare domain. See config/caddy/Caddyfile for DNS and CA-trust setup.
BASE_DOMAIN=homeserve.lan

# UID/GID that owns Speedtest Tracker files under data/speedtest.
PUID=1000
PGID=1000

# Optional: backup destination for scripts/backup.sh (default /srv/backups/local).
# Must be under /srv/backups, /mnt, or /media.
# BACKUP_DEST=/mnt/verified-backup-target

# Optional: disk usage warning threshold in percent for scripts/disk-status.sh
# (default 90).
# DISK_WARN_PERCENT=90
