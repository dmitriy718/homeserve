[Unit]
Description=GitHub Actions self-hosted runner
After=network-online.target
Wants=network-online.target

[Service]
User=github-runner
Group=github-runner
WorkingDirectory=/srv/builds/github-runner
ExecStart=/srv/builds/github-runner/run.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/builds/github-runner /srv/repos/github-actions

[Install]
WantedBy=multi-user.target

