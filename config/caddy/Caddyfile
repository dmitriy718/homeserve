# Caddy edge proxy for the ai-node stack ("the front door").
#
# Serves every web UI on a subdomain of {$BASE_DOMAIN} (default homeserve.lan,
# set BASE_DOMAIN in /srv/ai-node/.env) with automatic internal TLS: Caddy runs
# its own local CA and issues certificates for these names (tls internal).
# Plain HTTP on port 80 redirects to HTTPS automatically.
#
# Single sign-on: most sites import the (sso) snippet below, which delegates
# authentication to Authelia (forward_auth). Unauthenticated browsers are
# redirected to https://auth.BASE_DOMAIN; after login, Authelia's session
# cookie (scoped to the whole BASE_DOMAIN) lets them through to every
# protected site. Users are managed in LLDAP at https://lldap.BASE_DOMAIN.
# Exemptions, deliberately:
#   - gateway: machine-to-machine API with its own bearer-key auth;
#     forward_auth would break tool callers.
#   - ntfy: the ntfy phone app cannot complete an Authelia login (and
#     Alertmanager posts internally anyway). Left unprotected; ntfy has its
#     own auth (NTFY_AUTH_*) if you want to enable it.
#
# Making the names resolve (pick one):
#   - Router/dnsmasq: add address=/homeserve.lan/192.168.1.68 (covers all
#     subdomains with one wildcard entry).
#   - Pi-hole: Local DNS record for homeserve.lan plus each subdomain, or a
#     dnsmasq.d wildcard as above.
#   - Per device: /etc/hosts entries, one line per subdomain:
#       192.168.1.68 homeserve.lan auth.homeserve.lan lldap.homeserve.lan \
#         webui.homeserve.lan comfy.homeserve.lan grafana.homeserve.lan \
#         kuma.homeserve.lan prom.homeserve.lan gateway.homeserve.lan \
#         ntfy.homeserve.lan jellyfin.homeserve.lan immich.homeserve.lan \
#         cloud.homeserve.lan
#
# Trusting the internal CA on client devices (needed to avoid browser
# warnings; TLS is still encrypted without it):
#   1. Copy the root certificate out of the Caddy data volume:
#        sudo docker cp edge-caddy:/data/caddy/pki/authorities/local/root.crt \
#          ./homeserve-root-ca.crt
#   2. Install it as a trusted root on each client:
#        Linux:   sudo cp homeserve-root-ca.crt /usr/local/share/ca-certificates/
#                 && sudo update-ca-certificates
#        macOS:   add to the login keychain, set "Always Trust"
#        Windows: import into "Trusted Root Certification Authorities"
#        Android/iOS: install as a CA certificate in security settings
#
# Some services keep direct per-service ports as legacy access (e.g. ComfyUI
# on 192.168.1.68:8188); Open WebUI and Grafana are proxy-only. This proxy is
# the intended entry point everywhere.

# No global options block: defaults are what we want. The admin API stays on
# localhost:2019 inside the container and is used by the compose healthcheck;
# automatic HTTPS sets up the port-80 redirect for every site below.

# SSO gate: ask Authelia whether the request carries a valid session; it
# answers 2xx (proxied through, with the identity headers copied below into
# the upstream request) or redirects the browser to the portal to log in.
(sso) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth?authelia_url=https://auth.{$BASE_DOMAIN:homeserve.lan}/
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

# Authelia SSO portal. Reachable without a session (it IS the login page).
auth.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	reverse_proxy authelia:9091
}

# LLDAP user-management UI. It sits behind SSO like the other UIs; this is
# not circular (Authelia authenticates against LLDAP's LDAP port directly,
# not through this site). To restrict it to LLDAP's admin group, see the
# commented ACL rule in config/authelia/configuration.yml.
lldap.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy lldap:17170
}

# Landing dashboard (static files from services/dashboard, mounted at /srv).
{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	root * /srv
	file_server
}

webui.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy open-webui:8080
}

comfy.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy comfyui:8188
}

grafana.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy grafana:3000
}

kuma.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy uptime-kuma:3001
}

prom.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy prometheus:9090
}

# Optional apps (apps/ overlays). These routes answer 502 until the
# corresponding overlay is started — see docs/APPS.md.
jellyfin.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy jellyfin:8096
}

immich.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy immich-server:2283
}

cloud.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	import sso
	reverse_proxy nextcloud:80
}

# Machine-to-machine API with its own bearer-key auth: NOT behind SSO (see
# header comment).
gateway.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	reverse_proxy agent-gateway:8090
}

# Push endpoint for Alertmanager and the ntfy mobile app: NOT behind SSO (see
# header comment).
ntfy.{$BASE_DOMAIN:homeserve.lan} {
	tls internal
	reverse_proxy ntfy:80
}
