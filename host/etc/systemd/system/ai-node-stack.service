[Unit]
Description=AI node Docker Compose stack
Requires=docker.service
Wants=network-online.target tailscaled.service
After=docker.service network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/ai-node
ExecStartPre=/srv/ai-node/scripts/validate-config.sh --strict
ExecStartPre=/srv/ai-node/scripts/wait-network-addresses.sh
ExecStart=/usr/bin/docker compose --env-file /srv/ai-node/.env -f /srv/ai-node/compose/ai-node.yml up -d --remove-orphans
ExecStartPost=/srv/ai-node/scripts/wait-stack-healthy.sh
# Regenerate label-derived probe targets and dashboard tiles on every stack
# start. Label changes take effect on stack restart or a manual run of the
# script; see docs/APP_MANIFEST.md.
ExecStartPost=/srv/ai-node/scripts/discover-services.sh
ExecReload=/usr/bin/docker compose --env-file /srv/ai-node/.env -f /srv/ai-node/compose/ai-node.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /srv/ai-node/.env -f /srv/ai-node/compose/ai-node.yml stop --timeout 45
TimeoutStartSec=600
TimeoutStopSec=120
Restart=on-failure
RestartSec=30
UMask=0027

[Install]
WantedBy=multi-user.target
