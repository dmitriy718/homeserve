# Immich secrets for apps/immich.yml.
# Copy this file to ../secrets/immich.env (i.e. secrets/immich.env in the
# repository root, /srv/ai-node/secrets/immich.env on the installed host)
# and replace the password BEFORE first start.
#
# Generate a password with:  openssl rand -hex 16
#
# Changing DB_PASSWORD after the database is initialized has no effect on
# the stored Postgres password — set it once, before the first `up`.
DB_PASSWORD=change-me
