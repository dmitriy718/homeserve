# LLDAP admin credentials, generated by scripts/bootstrap-secrets.sh.
#
# LLDAP_LDAP_USER_PASS is the password for the built-in "admin" account:
# both the login to the LLDAP user-management UI (https://lldap.BASE_DOMAIN)
# and the password Authelia uses to bind to LDAP. It must stay in sync with
# secrets/authelia-ldap-bind.secret (bootstrap-secrets.sh copies it there).
# Generate with: openssl rand -base64 24
LLDAP_JWT_SECRET=replace-with-openssl-rand-hex-32-output
LLDAP_LDAP_USER_PASS=replace-with-openssl-rand-base64-24-output
