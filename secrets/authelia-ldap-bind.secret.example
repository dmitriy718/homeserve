# Placeholder for the LDAP bind password file Authelia uses (Docker secret).
#
# The real secrets/authelia-ldap-bind.secret is git-ignored and generated by
# scripts/bootstrap-secrets.sh by copying LLDAP_LDAP_USER_PASS out of
# secrets/lldap.env — the two must always match (it is the password of
# LLDAP's "admin" service account).
# compose/ai-node.yml mounts it at /run/secrets/authelia_ldap_bind_password
# and points AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD_FILE at it.
replace-with-lldap-user-pass-from-secrets-lldap-env
