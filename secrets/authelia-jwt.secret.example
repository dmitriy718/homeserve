# Authelia password-reset JWT HMAC secret.
# Real file: secrets/authelia-jwt.secret (generated by scripts/bootstrap-secrets.sh,
# or manually: openssl rand -hex 32). Mounted as the authelia_jwt_secret Docker
# secret; see AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE in
# compose/ai-node.yml.
REPLACE_WITH_64_RANDOM_HEX_CHARS
