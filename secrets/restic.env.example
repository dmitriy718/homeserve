# Restic offsite backup configuration. Copy to /srv/ai-node/secrets/restic.env
# (mode 0600) and set RESTIC_REPOSITORY. The encryption password file is
# auto-generated at /srv/ai-node/secrets/restic-password on first run —
# back it up separately; without it the offsite snapshots are unreadable.
#
# Examples:
#   RESTIC_REPOSITORY=s3:https://s3.amazonaws.com/my-bucket/ai-node
#   RESTIC_REPOSITORY=sftp:backup-host:/srv/restic/ai-node
#   RESTIC_REPOSITORY=/mnt/external-disk/restic/ai-node
RESTIC_REPOSITORY=

# S3 backends additionally need credentials in this file:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Override only to store the password somewhere else:
# RESTIC_PASSWORD_FILE=/srv/ai-node/secrets/restic-password
